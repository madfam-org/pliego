# Local development only. Placeholders: never put real credentials in this file or in git.
# Production values arrive through the Enclii secret intake (names: infra/k8s/production/secrets-template.yaml).
PLIEGO_ENV=local
PLIEGO_PUBLIC_LANDING_HOST=localhost:8000
PLIEGO_PUBLIC_APP_HOST=app.localhost:8000
PLIEGO_PUBLIC_API_HOST=api.localhost:8000
PLIEGO_CORS_ORIGINS=http://localhost:8000,http://app.localhost:8000
PLIEGO_JANUA_ISSUER=https://auth.madfam.io
PLIEGO_JANUA_AUDIENCE=pliego-api
PLIEGO_JANUA_JWKS_URL=https://auth.madfam.io/.well-known/jwks.json
PLIEGO_TRUSTED_PROXY_HEADER=
PLIEGO_METRICS_PORT=9090
AUTH_JANUA_CLIENT_ID=
AUTH_JANUA_CLIENT_SECRET=
PLIEGO_SESSION_SECRET=
# AI is inert while SELVA_BASE_URL is empty (every AI route answers 503). Never a provider key here.
SELVA_BASE_URL=
SELVA_API_TOKEN=
