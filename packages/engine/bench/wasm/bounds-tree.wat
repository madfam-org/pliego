;; AGPL-3.0-only. Scalar binary64 kernel; no relaxed SIMD or floating reductions.
;; Header i32 byte offsets: nodes=0,count=4,boxes=8,left=12,right=16,primitive=20,
;; inactive=24,anyInactive=28,maxRank=32,rank=36,stack=40,hits=44,order=48,
;; primitiveInactive=52,sourceBoxes=56. F64 metrics: nodeTests=64,rootTests=72.
;; Host validates layout and copies inputs before calls. Tree topology is immutable.
(module
  (import "env" "memory" (memory 1))
  (func (export "refit")
    (local $n i32) (local $i i32) (local $k i32) (local $id i32)
    (local $a i32) (local $b i32) (local $target i32) (local $src i32)
    (local $boxes i32) (local $left i32) (local $right i32) (local $primitive i32)
    (local $inactive i32) (local $any i32) (local $max i32) (local $rank i32)
    (local $order i32) (local $flags i32) (local $source i32)
    (local.set $boxes (i32.load (i32.const 8)))
    (local.set $left (i32.load (i32.const 12)))
    (local.set $right (i32.load (i32.const 16)))
    (local.set $primitive (i32.load (i32.const 20)))
    (local.set $inactive (i32.load (i32.const 24)))
    (local.set $any (i32.load (i32.const 28)))
    (local.set $max (i32.load (i32.const 32)))
    (local.set $rank (i32.load (i32.const 36)))
    (local.set $order (i32.load (i32.const 48)))
    (local.set $flags (i32.load (i32.const 52)))
    (local.set $source (i32.load (i32.const 56)))
    (block $ranksDone (loop $ranks
      (br_if $ranksDone (i32.ge_u (local.get $i) (i32.load (i32.const 4))))
      (local.set $id (i32.load (i32.add (local.get $order) (i32.shl (local.get $i) (i32.const 2)))))
      (i32.store (i32.add (local.get $rank) (i32.shl (local.get $id) (i32.const 2))) (local.get $i))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $ranks)))
    (local.set $n (i32.sub (i32.load (i32.const 0)) (i32.const 1)))
    (block $nodesDone (loop $nodes
      (br_if $nodesDone (i32.lt_s (local.get $n) (i32.const 0)))
      (local.set $id (i32.load (i32.add (local.get $primitive) (i32.shl (local.get $n) (i32.const 2)))))
      (local.set $target (i32.add (local.get $boxes) (i32.mul (local.get $n) (i32.const 48))))
      (if (i32.ge_s (local.get $id) (i32.const 0))
        (then
          (local.set $src (i32.add (local.get $source) (i32.mul (local.get $id) (i32.const 48))))
          (local.set $k (i32.const 0))
          (loop $copy
            (f64.store (i32.add (local.get $target) (local.get $k)) (f64.load (i32.add (local.get $src) (local.get $k))))
            (local.set $k (i32.add (local.get $k) (i32.const 8)))
            (br_if $copy (i32.lt_u (local.get $k) (i32.const 48))))
          (i32.store8 (i32.add (local.get $inactive) (local.get $n)) (i32.load8_u (i32.add (local.get $flags) (local.get $id))))
          (i32.store8 (i32.add (local.get $any) (local.get $n)) (i32.load8_u (i32.add (local.get $flags) (local.get $id))))
          (i32.store (i32.add (local.get $max) (i32.shl (local.get $n) (i32.const 2)))
            (i32.load (i32.add (local.get $rank) (i32.shl (local.get $id) (i32.const 2))))))
        (else
          (local.set $a (i32.load (i32.add (local.get $left) (i32.shl (local.get $n) (i32.const 2)))))
          (local.set $b (i32.load (i32.add (local.get $right) (i32.shl (local.get $n) (i32.const 2)))))
          (local.set $src (i32.add (local.get $boxes) (i32.mul (local.get $a) (i32.const 48))))
          (local.set $id (i32.add (local.get $boxes) (i32.mul (local.get $b) (i32.const 48))))
          (local.set $k (i32.const 0))
          (loop $union
            (f64.store (i32.add (local.get $target) (local.get $k))
              (f64.min (f64.load (i32.add (local.get $src) (local.get $k))) (f64.load (i32.add (local.get $id) (local.get $k)))))
            (f64.store offset=24 (i32.add (local.get $target) (local.get $k))
              (f64.max (f64.load offset=24 (i32.add (local.get $src) (local.get $k))) (f64.load offset=24 (i32.add (local.get $id) (local.get $k)))))
            (local.set $k (i32.add (local.get $k) (i32.const 8)))
            (br_if $union (i32.lt_u (local.get $k) (i32.const 24))))
          (i32.store8 (i32.add (local.get $inactive) (local.get $n))
            (i32.and (i32.ne (i32.load8_u (i32.add (local.get $inactive) (local.get $a))) (i32.const 0))
              (i32.ne (i32.load8_u (i32.add (local.get $inactive) (local.get $b))) (i32.const 0))))
          (i32.store8 (i32.add (local.get $any) (local.get $n))
            (i32.or (i32.ne (i32.load8_u (i32.add (local.get $any) (local.get $a))) (i32.const 0))
              (i32.ne (i32.load8_u (i32.add (local.get $any) (local.get $b))) (i32.const 0))))
          (local.set $a (i32.load (i32.add (local.get $max) (i32.shl (local.get $a) (i32.const 2)))))
          (local.set $b (i32.load (i32.add (local.get $max) (i32.shl (local.get $b) (i32.const 2)))))
          (i32.store (i32.add (local.get $max) (i32.shl (local.get $n) (i32.const 2)))
            (select (local.get $a) (local.get $b) (i32.gt_s (local.get $a) (local.get $b))))))
      (local.set $n (i32.sub (local.get $n) (i32.const 1))) (br $nodes)))
    (f64.store (i32.const 64) (f64.const 0))
    (f64.store (i32.const 72) (f64.const 0)))

  ;; Negative return encodes -(count+1) for already-sorted enclosing-root hits.
  (func (export "query") (param $fixed i32) (param $after f64) (param $before i32) (param $begin i32)
    (param $q0 f64) (param $q1 f64) (param $q2 f64) (param $q3 f64) (param $q4 f64) (param $q5 f64) (result i32)
    (local $n i32) (local $size i32) (local $count i32) (local $r i32) (local $id i32) (local $stationary i32)
    (local $box i32) (local $boxes i32) (local $left i32) (local $right i32) (local $primitive i32)
    (local $inactive i32) (local $any i32) (local $max i32) (local $rank i32)
    (local $stack i32) (local $hits i32) (local $order i32) (local $flags i32) (local $tests f64)
    (local.set $boxes (i32.load (i32.const 8)))
    (local.set $left (i32.load (i32.const 12))) (local.set $right (i32.load (i32.const 16)))
    (local.set $primitive (i32.load (i32.const 20)))
    (local.set $inactive (i32.load (i32.const 24))) (local.set $any (i32.load (i32.const 28)))
    (local.set $max (i32.load (i32.const 32))) (local.set $rank (i32.load (i32.const 36)))
    (local.set $stack (i32.load (i32.const 40))) (local.set $hits (i32.load (i32.const 44)))
    (local.set $order (i32.load (i32.const 48))) (local.set $flags (i32.load (i32.const 52)))
    (if (i32.eqz (i32.load (i32.const 0))) (then (return (i32.const 0))))
    (if (i32.and (f64.le (f64.convert_i32_s (i32.load (local.get $max))) (local.get $after))
      (i32.or (i32.eqz (local.get $before)) (i32.eqz (i32.load8_u (local.get $any)))))
      (then (return (i32.const 0))))
    (if (i32.and (local.get $fixed) (i32.ne (i32.load8_u (local.get $inactive)) (i32.const 0)))
      (then (return (i32.const 0))))
    (f64.store (i32.const 72) (f64.add (f64.load (i32.const 72)) (f64.const 1)))
    (block $notEnclosing
      (br_if $notEnclosing (f64.gt (local.get $q0) (f64.load (local.get $boxes))))
      (br_if $notEnclosing (f64.gt (local.get $q1) (f64.load offset=8 (local.get $boxes))))
      (br_if $notEnclosing (f64.gt (local.get $q2) (f64.load offset=16 (local.get $boxes))))
      (br_if $notEnclosing (f64.lt (local.get $q3) (f64.load offset=24 (local.get $boxes))))
      (br_if $notEnclosing (f64.lt (local.get $q4) (f64.load offset=32 (local.get $boxes))))
      (br_if $notEnclosing (f64.lt (local.get $q5) (f64.load offset=40 (local.get $boxes))))
      (local.set $r (local.get $begin))
      (block $allDone (loop $all
        (br_if $allDone (i32.ge_u (local.get $r) (i32.load (i32.const 4))))
        (local.set $id (i32.load (i32.add (local.get $order) (i32.shl (local.get $r) (i32.const 2)))))
        (local.set $stationary (i32.ne (i32.load8_u (i32.add (local.get $flags) (local.get $id))) (i32.const 0)))
        (if (i32.and
          (i32.or (f64.gt (f64.convert_i32_s (local.get $r)) (local.get $after)) (i32.and (local.get $before) (local.get $stationary)))
          (i32.eqz (i32.and (local.get $fixed) (local.get $stationary))))
          (then
            (i32.store (i32.add (local.get $hits) (i32.shl (local.get $count) (i32.const 2))) (local.get $r))
            (local.set $count (i32.add (local.get $count) (i32.const 1)))))
        (local.set $r (i32.add (local.get $r) (i32.const 1))) (br $all)))
      (return (i32.sub (i32.const -1) (local.get $count))))
    (local.set $tests (f64.load (i32.const 64)))
    (i32.store (local.get $stack) (i32.const 0)) (local.set $size (i32.const 1))
    (block $walkDone (loop $walk
      (br_if $walkDone (i32.eqz (local.get $size)))
      (local.set $size (i32.sub (local.get $size) (i32.const 1)))
      (local.set $n (i32.load (i32.add (local.get $stack) (i32.shl (local.get $size) (i32.const 2)))))
      (block $skip
        (br_if $skip (i32.and
          (f64.le (f64.convert_i32_s (i32.load (i32.add (local.get $max) (i32.shl (local.get $n) (i32.const 2))))) (local.get $after))
          (i32.or (i32.eqz (local.get $before)) (i32.eqz (i32.load8_u (i32.add (local.get $any) (local.get $n)))))))
        (br_if $skip (i32.and (local.get $fixed) (i32.ne (i32.load8_u (i32.add (local.get $inactive) (local.get $n))) (i32.const 0))))
        (local.set $tests (f64.add (local.get $tests) (f64.const 1)))
        (local.set $box (i32.add (local.get $boxes) (i32.mul (local.get $n) (i32.const 48))))
        (br_if $skip (f64.gt (local.get $q0) (f64.load offset=24 (local.get $box))))
        (br_if $skip (f64.gt (f64.load (local.get $box)) (local.get $q3)))
        (br_if $skip (f64.gt (local.get $q1) (f64.load offset=32 (local.get $box))))
        (br_if $skip (f64.gt (f64.load offset=8 (local.get $box)) (local.get $q4)))
        (br_if $skip (f64.gt (local.get $q2) (f64.load offset=40 (local.get $box))))
        (br_if $skip (f64.gt (f64.load offset=16 (local.get $box)) (local.get $q5)))
        (local.set $id (i32.load (i32.add (local.get $primitive) (i32.shl (local.get $n) (i32.const 2)))))
        (if (i32.ge_s (local.get $id) (i32.const 0))
          (then
            (i32.store (i32.add (local.get $hits) (i32.shl (local.get $count) (i32.const 2)))
              (i32.load (i32.add (local.get $rank) (i32.shl (local.get $id) (i32.const 2)))))
            (local.set $count (i32.add (local.get $count) (i32.const 1))))
          (else
            (i32.store (i32.add (local.get $stack) (i32.shl (local.get $size) (i32.const 2)))
              (i32.load (i32.add (local.get $right) (i32.shl (local.get $n) (i32.const 2)))))
            (local.set $size (i32.add (local.get $size) (i32.const 1)))
            (i32.store (i32.add (local.get $stack) (i32.shl (local.get $size) (i32.const 2)))
              (i32.load (i32.add (local.get $left) (i32.shl (local.get $n) (i32.const 2)))))
            (local.set $size (i32.add (local.get $size) (i32.const 1))))))
      (br $walk)))
    (f64.store (i32.const 64) (local.get $tests))
    (local.get $count)))
