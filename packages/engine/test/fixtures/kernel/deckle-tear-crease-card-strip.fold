  "mode": "physical",
  "steps": [
   {
    "duration_ms": 1400,
    "id": "fold-over",
    "label": {
     "en": "Fold the strip over along the line",
     "es": "Dobla la tira hacia delante por la línea",
     "fr": "Rabattre la bande le long de la ligne",
     "pt": "Dobre a tira para a frente pela linha"
    },
    "note": {
     "en": "Press the fold hard with a bone folder or a thumbnail.",
     "es": "Marca el doblez con fuerza, con una plegadera o con la uña.",
     "fr": "Marquez fortement le pli à l'os à plier ou à l'ongle.",
     "pt": "Vinque a dobra com força, com uma dobradeira ou com a unha."
    },
    "release": [],
    "targets": [
     [
      3,
      180
     ]
    ]
   },
   {
    "duration_ms": 900,
    "id": "open",
    "label": {
     "en": "Open it",
     "es": "Ábrela",
     "fr": "L'ouvrir",
     "pt": "Abra"
    },
    "note": null,
    "release": [],
    "targets": [
     [
      3,
      0
     ]
    ]
   },
   {
    "duration_ms": 1400,
    "id": "fold-back",
    "label": {
     "en": "Fold it back the other way",
     "es": "Dóblala hacia atrás, al otro lado",
     "fr": "La replier dans l'autre sens",
     "pt": "Dobre para trás, para o outro lado"
    },
    "note": {
     "en": "Folding both ways breaks the fibres along the line.",
     "es": "Doblar hacia los dos lados rompe las fibras a lo largo de la línea.",
     "fr": "Plier dans les deux sens casse les fibres le long de la ligne.",
     "pt": "Dobrar para os dois lados quebra as fibras ao longo da linha."
    },
    "release": [],
    "targets": [
     [
      3,
      -180
     ]
    ]
   },
   {
    "duration_ms": 900,
    "id": "open-again",
    "label": {
     "en": "Open it again",
     "es": "Ábrela de nuevo",
     "fr": "La rouvrir",
     "pt": "Abra de novo"
    },
    "note": null,
    "release": [],
    "targets": [
     [
      3,
      0
     ]
    ]
   },
   {
    "duration_ms": 1800,
    "id": "tear",
    "label": {
     "en": "Tear the strip off along the crease",
     "es": "Desprende la tira por el pliegue",
     "fr": "Détacher la bande le long du pli",
     "pt": "Destaque a tira pelo vinco"
    },
    "note": {
     "en": "Start at one end and pull slowly, close to the line.",
     "es": "Empieza por un extremo y jala despacio, cerca de la línea.",
     "fr": "Commencer par un bout et tirer lentement, près de la ligne.",
     "pt": "Comece por uma ponta e puxe devagar, perto da linha."
    },
    "release": [],
    "remove": [
     "strip"
    ],
    "targets": []
   }
  ]
 },
